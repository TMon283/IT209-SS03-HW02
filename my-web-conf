server {
    listen 80;
    server_name _;
    
    root /var/www/my-web/html;
    index index.html;

    # Cấu hình chuyển hướng lỗi 404 về tệp 404.html
    error_page 404 /404.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Bảo vệ tệp 404.html, chặn truy cập trực tiếp từ internet
    location = /404.html {
        root /var/www/my-web/html;
        internal;
    }
}